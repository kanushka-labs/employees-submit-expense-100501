title Expense Claims & Payroll Export

component expense-webapp as "Expense Webapp" web-application
component expense-api as "Expense API" service
component category-agent as "Category Suggestion Agent" ai-agent
component claims-db as "Claims Database" database
component agent-memory-db as "Agent Memory Database" database

east user-auth as "Thunder Auth" identity-server
south payroll-service as "Payroll Service" service

north -> expense-webapp
north -> expense-api
north -> category-agent

expense-webapp -> expense-api
expense-webapp -> category-agent
expense-webapp -> user-auth

expense-api -> user-auth
expense-api -> claims-db
expense-api -> payroll-service

category-agent -> user-auth
category-agent -> agent-memory-db
